<Project Sdk="Microsoft.NET.Sdk">

  <!-- ViewModels sin dependencia de WPF: se compilan y prueban en cualquier plataforma. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>KizaTweaks.Presentation</RootNamespace>
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\KizaTweaks.Core\KizaTweaks.Core.csproj" />
  </ItemGroup>

</Project>
