<Window x:Class="KizaTweaks.App.Dialogs.DialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="560" SizeToContent="Height" MaxHeight="720"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource SurfaceBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="{StaticResource UiFont}" FontSize="14">
    <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
        <Grid Margin="24,20,24,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                <Border Width="6" Height="22" CornerRadius="3" Background="{StaticResource BrandGradient}" Margin="0,0,10,0" />
                <TextBlock x:Name="TitleText" Style="{StaticResource H2}" VerticalAlignment="Center" />
            </StackPanel>
            <ScrollViewer Grid.Row="1" MaxHeight="460" VerticalScrollBarVisibility="Auto">
                <TextBlock x:Name="MessageText" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" LineHeight="21" />
            </ScrollViewer>
            <StackPanel x:Name="Buttons" Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0" />
        </Grid>
    </Border>
</Window>
