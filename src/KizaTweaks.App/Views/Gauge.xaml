<UserControl x:Class="KizaTweaks.App.Views.Gauge"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root" Width="196" Height="196">
    <Grid>
        <Path x:Name="Track" Stroke="{StaticResource LineBrush}" StrokeThickness="14"
              StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
        <Path x:Name="Bar" Stroke="{StaticResource BrandGradient}" StrokeThickness="14"
              StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,4,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <TextBlock x:Name="Number" FontFamily="{StaticResource DisplayFont}" FontSize="52" FontWeight="SemiBold" />
                <TextBlock Text="%" FontFamily="{StaticResource DisplayFont}" FontSize="22" Foreground="{StaticResource MutedBrush}"
                           VerticalAlignment="Bottom" Margin="2,0,0,10" />
            </StackPanel>
            <TextBlock Text="{Binding Caption, ElementName=Root}" Style="{StaticResource Caption}" HorizontalAlignment="Center"
                       TextAlignment="Center" MaxWidth="120" Margin="0,-4,0,0" />
        </StackPanel>
    </Grid>
</UserControl>
