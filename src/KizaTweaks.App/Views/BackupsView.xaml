<UserControl x:Class="KizaTweaks.App.Views.BackupsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,28,32,32">
            <TextBlock Text="Respaldos" Style="{StaticResource H1}" />
            <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,20"
                       Text="Antes de cambiar algo, KizaTweaks guarda cómo estaba. «Deshacer» deja ese ajuste exactamente como lo tenías, no en un valor genérico." />

            <WrapPanel Margin="0,0,0,20">
                <Button Content="Crear punto de restauración" Command="{Binding RestorePointCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,8,8" />
                <Button Content="Abrir Restaurar sistema" Command="{Binding OpenSystemRestoreCommand}" Margin="0,0,8,8"
                        ToolTip="Herramienta de Windows para volver a un punto de restauración." />
                <Button Content="Deshacer todo" Command="{Binding UndoAllCommand}" Style="{StaticResource DangerButton}" Margin="0,0,8,8" />
                <Button Content="Abrir carpeta de datos y registros" Command="{Binding OpenDataFolderCommand}" Style="{StaticResource GhostButton}" Margin="0,0,8,8" />
            </WrapPanel>

            <TextBlock Text="Ajustes aplicados con KizaTweaks" Style="{StaticResource H2}" Margin="0,0,0,10" />
            <TextBlock Text="Todavía no has aplicado ajustes." Style="{StaticResource Muted}" Margin="0,0,0,10"
                       Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}" />
            <ItemsControl ItemsSource="{Binding Items}" Margin="0,0,0,24">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Padding="16,12" Margin="0,0,0,8">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="Deshacer" Command="{Binding UndoCommand}" VerticalAlignment="Center" />
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding When}" Style="{StaticResource Caption}" />
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Text="Historial" Style="{StaticResource H2}" Margin="0,0,0,10" />
            <Border Style="{StaticResource Card}" Padding="16,12">
                <ItemsControl ItemsSource="{Binding History}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Margin="0,3" ToolTip="{Binding Detail}">
                                <Ellipse Width="8" Height="8" Fill="{Binding Color, Converter={StaticResource HexBrush}}" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding Text}" Margin="10,0,0,0" FontFamily="{StaticResource MonoFont}" FontSize="12.5" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
