<UserControl x:Class="KizaTweaks.App.Views.MaintenanceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:KizaTweaks.App.Views">
    <Grid Margin="32,28,32,24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="0.8*" MinWidth="300" MaxWidth="440" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.ColumnSpan="2" Margin="0,0,0,16">
            <TextBlock Text="Mantenimiento" Style="{StaticResource H1}" />
            <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,0"
                       Text="Optimiza discos, libera espacio y repara Windows con sus propias herramientas. Cada tarea muestra el comando exacto que ejecuta." />
        </StackPanel>

        <!-- ============ Tareas ============ -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,16,0">
            <StackPanel>
                <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Ejecutar" Command="{Binding QuickCommand}" Style="{StaticResource PrimaryButton}"
                                VerticalAlignment="Center" Margin="16,0,0,0" />
                        <StackPanel>
                            <TextBlock Text="Mantenimiento rápido" Style="{StaticResource H2}" />
                            <TextBlock Text="De 1 a 3 minutos. Seguro para hacer cada semana." Style="{StaticResource Caption}" Margin="0,2,0,8" />
                            <TextBlock Text="{Binding QuickList}" Style="{StaticResource Muted}" FontSize="12.5" />
                        </StackPanel>
                    </DockPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="0,0,0,22">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Ejecutar" Command="{Binding FullCommand}" VerticalAlignment="Center" Margin="16,0,0,0" />
                        <StackPanel>
                            <TextBlock Text="Mantenimiento completo" Style="{StaticResource H2}" />
                            <TextBlock Text="De 15 a 60 minutos. Una vez al mes." Style="{StaticResource Caption}" Margin="0,2,0,8" />
                            <TextBlock Text="{Binding FullList}" Style="{StaticResource Muted}" FontSize="12.5" />
                        </StackPanel>
                    </DockPanel>
                </Border>

                <ItemsControl ItemsSource="{Binding Groups}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,0,0,18">
                                <TextBlock Text="{Binding Name}" Style="{StaticResource H2}" Margin="0,0,0,10" />
                                <ItemsControl ItemsSource="{Binding Items}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource Card}" Padding="16,12" Margin="0,0,0,8">
                                                <DockPanel>
                                                    <Button DockPanel.Dock="Right" Content="Ejecutar" Command="{Binding RunCommand}"
                                                            VerticalAlignment="Center" Margin="16,0,0,0" />
                                                    <StackPanel>
                                                        <WrapPanel>
                                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0" />
                                                            <views:Pill Text="{Binding RiskLabel}" Color="{Binding RiskColor}" />
                                                            <views:Pill Text="Reinicio" Color="#FFB86B" Visibility="{Binding RequiresReboot, Converter={StaticResource BoolToVis}}" />
                                                            <views:Pill Text="{Binding Duration}" Color="#9C8A95" />
                                                        </WrapPanel>
                                                        <TextBlock Text="{Binding Description}" Style="{StaticResource Muted}" Margin="0,6,0,0" />
                                                        <TextBlock Text="{Binding Note}" Foreground="#F3CD8F" TextWrapping="Wrap" Margin="0,4,0,0"
                                                                   Visibility="{Binding HasNote, Converter={StaticResource BoolToVis}}" />
                                                        <TextBlock Text="{Binding Command}" FontFamily="{StaticResource MonoFont}" FontSize="12"
                                                                   Foreground="{StaticResource SubtleBrush}" TextWrapping="Wrap" Margin="0,6,0,0" />
                                                        <TextBlock Text="{Binding Status}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,6,0,0"
                                                                   Foreground="{Binding StatusColor, Converter={StaticResource HexBrush}}"
                                                                   Visibility="{Binding HasStatus, Converter={StaticResource BoolToVis}}" />
                                                    </StackPanel>
                                                </DockPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <!-- ============ Consola ============ -->
        <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource Card}" Padding="0">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="16,12,10,8">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Content="Cancelar" Command="{Binding CancelCommand}" Style="{StaticResource DangerButton}" Padding="12,4"
                                Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}" Margin="0,0,6,0" />
                        <Button Content="Limpiar" Command="{Binding ClearOutputCommand}" Style="{StaticResource GhostButton}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="&#xE756;" Style="{StaticResource Icon}" FontSize="14" Foreground="{StaticResource Accent2Brush}" />
                        <TextBlock Text="Consola" FontWeight="SemiBold" Margin="8,0,0,0" />
                        <TextBlock Text="{Binding CurrentTask}" Style="{StaticResource Caption}" Margin="10,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </DockPanel>
                <TextBox x:Name="ConsoleBox" Text="{Binding Output, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto" FontFamily="{StaticResource MonoFont}" FontSize="12"
                         Background="{StaticResource BgBrush}" Foreground="#E2D3DB" BorderThickness="0"
                         Height="Auto" VerticalContentAlignment="Top" Padding="12,8" Margin="1,0,1,1"
                         TextChanged="Console_TextChanged">
                    <TextBox.Template>
                        <ControlTemplate TargetType="TextBox">
                            <Border Background="{TemplateBinding Background}" CornerRadius="0,0,12,12">
                                <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" />
                            </Border>
                        </ControlTemplate>
                    </TextBox.Template>
                </TextBox>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
