<UserControl x:Class="KizaTweaks.App.Views.ProcessesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:KizaTweaks.App.Views">
    <Grid Margin="32,28,32,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="340" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.ColumnSpan="2" Margin="0,0,0,16">
            <TextBlock Text="Procesos" Style="{StaticResource H1}" />
            <TextBlock Text="{Binding Summary}" Style="{StaticResource Muted}" Margin="0,4,0,0" />
        </StackPanel>

        <!-- ============ Lista de procesos ============ -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="14" Margin="0,0,16,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <DockPanel Margin="0,0,0,10">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <CheckBox Content="Mostrar procesos de Windows" IsChecked="{Binding ShowSystem}" Margin="12,0,8,0" />
                        <Button Content="Actualizar" Command="{Binding RefreshCommand}" Style="{StaticResource GhostButton}" />
                    </StackPanel>
                    <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Tag="Buscar proceso…" />
                </DockPanel>

                <!-- Encabezados -->
                <Grid Grid.Row="1" Margin="10,0,18,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="70" />
                        <ColumnDefinition Width="80" />
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="140" />
                    </Grid.ColumnDefinitions>
                    <Grid.Resources>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource Caption}" />
                    </Grid.Resources>
                    <TextBlock Text="NOMBRE" />
                    <TextBlock Grid.Column="1" Text="CPU" />
                    <TextBlock Grid.Column="2" Text="RAM" />
                    <TextBlock Grid.Column="3" Text="PRIORIDAD" />
                    <TextBlock Grid.Column="4" Text="TIPO" />
                </Grid>

                <ListBox Grid.Row="2" ItemsSource="{Binding Visible}" SelectedItem="{Binding Selected, Mode=TwoWay}"
                         Style="{StaticResource PlainListBox}" ItemContainerStyle="{StaticResource RowItem}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="70" />
                                    <ColumnDefinition Width="80" />
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="140" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{Binding Display}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap">
                                        <Run Text="{Binding Name, Mode=OneWay}" /><Run Text=".exe · PID " /><Run Text="{Binding Pid, Mode=OneWay}" />
                                    </TextBlock>
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="{Binding Cpu}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2" Text="{Binding Memory}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="3" Text="{Binding Priority}" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" />
                                <views:Pill Grid.Column="4" Text="{Binding KindLabel}" Color="{Binding KindColor}" HorizontalAlignment="Left" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Acciones sobre el seleccionado -->
                <WrapPanel Grid.Row="3" Margin="0,12,0,0">
                    <Button Content="Cerrar proceso" Command="{Binding KillCommand}" Style="{StaticResource DangerButton}" Margin="0,0,8,6" />
                    <Button Content="Prioridad alta" Command="{Binding SetPriorityCommand}" CommandParameter="High" Margin="0,0,8,6"
                            ToolTip="Hasta que se cierre el programa." />
                    <Button Content="Normal" Command="{Binding SetPriorityCommand}" CommandParameter="Normal" Margin="0,0,8,6" />
                    <Button Content="Baja" Command="{Binding SetPriorityCommand}" CommandParameter="BelowNormal" Margin="0,0,8,6"
                            ToolTip="Útil para programas de fondo pesados mientras juegas." />
                    <Button Content="Alta permanente (juego)" Command="{Binding PermanentHighCommand}" Margin="0,0,8,6"
                            ToolTip="Windows abrirá este .exe siempre con prioridad Alta." />
                </WrapPanel>
            </Grid>
        </Border>

        <!-- ============ Panel derecho ============ -->
        <ScrollViewer Grid.Row="1" Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="Sesión de juego" Style="{StaticResource H2}" />
                        <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,12"
                                   Text="Cierra en un clic lo que corre de fondo antes de jugar. Nada de esto es del sistema." />
                        <ItemsControl ItemsSource="{Binding Candidates}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="0,0,0,10" ToolTip="{Binding Why}">
                                        <CheckBox DockPanel.Dock="Left" IsChecked="{Binding IsSelected, Mode=TwoWay}" VerticalAlignment="Top" Margin="0,2,10,0" />
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding RunningLabel}" Style="{StaticResource Caption}" />
                                        </StackPanel>
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <Button Content="Cerrar seleccionados" Command="{Binding CloseCandidatesCommand}" Style="{StaticResource PrimaryButton}" />
                            <Button Content="Actualizar" Command="{Binding RefreshCandidatesCommand}" Style="{StaticResource GhostButton}" Margin="8,0,0,0" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Prioridad permanente" Style="{StaticResource H2}" />
                        <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,12"
                                   Text="Programas que Windows abre siempre con otra prioridad. Selecciona tu juego en la lista y pulsa «Alta permanente»." />
                        <TextBlock Text="Ninguna configurada." Style="{StaticResource Muted}"
                                   Visibility="{Binding PriorityRules.Count, Converter={StaticResource CountToVis}, ConverterParameter=zero}" />
                        <ItemsControl ItemsSource="{Binding PriorityRules}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="0,0,0,8">
                                        <Button DockPanel.Dock="Right" Content="Quitar" Command="{Binding RemoveCommand}" Style="{StaticResource GhostButton}" />
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding ExeName}" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding Label}" Style="{StaticResource Caption}" />
                                        </StackPanel>
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
