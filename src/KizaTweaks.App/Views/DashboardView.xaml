<UserControl x:Class="KizaTweaks.App.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:KizaTweaks.App.Views">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,28,32,32">

            <!-- Encabezado -->
            <DockPanel Margin="0,0,0,22">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Analizar de nuevo" Command="{Binding LoadCommand}" Style="{StaticResource GhostButton}" Margin="0,0,8,0" />
                    <Button Content="Punto de restauración" Command="{Binding RestorePointCommand}" Margin="0,0,8,0" />
                    <Button Command="{Binding ApplyGamerCommand}" Style="{StaticResource PrimaryButton}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE945;" Style="{StaticResource Icon}" FontSize="14" />
                            <TextBlock Text="Optimizar para juegos" Margin="8,0,0,0" />
                        </StackPanel>
                    </Button>
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="Tu equipo" Style="{StaticResource H1}" />
                    <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,0">
                        <Run Text="{Binding OsText, Mode=OneWay}" />
                        <Run Text=" · " />
                        <Run Text="{Binding DeviceType, Mode=OneWay}" />
                    </TextBlock>
                </StackPanel>
            </DockPanel>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,16" Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}">
                <views:Spinner>
                    <views:Spinner.LayoutTransform>
                        <ScaleTransform ScaleX="0.5" ScaleY="0.5" />
                    </views:Spinner.LayoutTransform>
                </views:Spinner>
                <TextBlock Text="Analizando hardware y configuración…" Style="{StaticResource Muted}" Margin="10,0,0,0" VerticalAlignment="Center" />
            </StackPanel>

            <!-- Puntaje + hardware -->
            <Grid Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="260" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource Card}" Margin="0,0,16,0">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Puntaje de configuración" Style="{StaticResource Muted}" />
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <TextBlock Text="{Binding Score}" FontFamily="{StaticResource DisplayFont}" FontSize="64" FontWeight="Bold"
                                       Foreground="{Binding ScoreColor, Converter={StaticResource HexBrush}}" />
                            <TextBlock Text="/100" FontSize="18" Foreground="{StaticResource SubtleBrush}" VerticalAlignment="Bottom" Margin="4,0,0,14" />
                        </StackPanel>
                        <TextBlock Text="{Binding ScoreLabel}" FontWeight="SemiBold"
                                   Foreground="{Binding ScoreColor, Converter={StaticResource HexBrush}}" />
                        <TextBlock Style="{StaticResource Caption}" Margin="0,10,0,0"
                                   Text="Mide qué tan bien configurado está tu equipo para jugar según las recomendaciones pendientes. Para FPS reales, usa Benchmark." />
                    </StackPanel>
                </Border>

                <UniformGrid Grid.Column="1" Columns="2" Rows="3">
                    <UniformGrid.Resources>
                        <Style TargetType="Border" BasedOn="{StaticResource Card}">
                            <Setter Property="Margin" Value="0,0,12,12" />
                            <Setter Property="Padding" Value="16,12" />
                        </Style>
                    </UniformGrid.Resources>
                    <Border>
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Left" Text="&#xE950;" Style="{StaticResource Icon}" FontSize="22" Foreground="{StaticResource AccentBrush}" Margin="0,0,14,0" />
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Procesador" Style="{StaticResource Caption}" />
                                <TextBlock Text="{Binding CpuText}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding CpuDetail}" Style="{StaticResource Caption}" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <Border>
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Left" Text="&#xE7F4;" Style="{StaticResource Icon}" FontSize="22" Foreground="{StaticResource Accent2Brush}" Margin="0,0,14,0" />
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Tarjeta gráfica" Style="{StaticResource Caption}" />
                                <TextBlock Text="{Binding GpuText}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding GpuDetail}" Style="{StaticResource Caption}" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <Border>
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Left" Text="&#xE964;" Style="{StaticResource Icon}" FontSize="22" Foreground="{StaticResource OkBrush}" Margin="0,0,14,0" />
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Memoria RAM" Style="{StaticResource Caption}" />
                                <TextBlock Text="{Binding RamText}" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding RamDetail}" Style="{StaticResource Caption}" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <Border>
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Left" Text="&#xE7F8;" Style="{StaticResource Icon}" FontSize="22" Foreground="{StaticResource WarnBrush}" Margin="0,0,14,0" />
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Pantalla" Style="{StaticResource Caption}" />
                                <TextBlock Text="{Binding DisplayText}" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding DisplayDetail}" Style="{StaticResource Caption}" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <Border>
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Left" Text="&#xE9F5;" Style="{StaticResource Icon}" FontSize="22" Foreground="{StaticResource MutedBrush}" Margin="0,0,14,0" />
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Placa base" Style="{StaticResource Caption}" />
                                <TextBlock Text="{Binding BoardText}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <Border>
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Left" Text="&#xE8CB;" Style="{StaticResource Icon}" FontSize="22" Foreground="{StaticResource MutedBrush}" Margin="0,0,14,0" />
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Ajustes de KizaTweaks" Style="{StaticResource Caption}" />
                                <Button Content="Ver todos los ajustes →" Style="{StaticResource LinkButton}" Command="{Binding GoTweaksCommand}" HorizontalAlignment="Left" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </UniformGrid>
            </Grid>

            <!-- Recomendaciones -->
            <TextBlock Text="Recomendaciones" Style="{StaticResource H2}" Margin="0,0,0,4" />
            <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,12"
                       Text="Ordenadas por impacto real. Las de hardware (BIOS, monitor) se hacen a mano; las demás se aplican con un clic." />
            <TextBlock Text="¡Todo en orden! No hay recomendaciones pendientes." Foreground="{StaticResource OkBrush}" Margin="0,0,0,12"
                       Visibility="{Binding Recommendations.Count, Converter={StaticResource CountToVis}, ConverterParameter=zero}" />
            <ItemsControl ItemsSource="{Binding Recommendations}" Margin="0,0,0,24">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Margin="0,0,0,10" Padding="18,14">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="{Binding ActionText}" Command="{Binding ActionCommand}"
                                        VerticalAlignment="Center" Margin="16,0,0,0"
                                        Visibility="{Binding HasAction, Converter={StaticResource BoolToVis}}" />
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <views:Pill Text="{Binding SeverityLabel}" Color="{Binding SeverityColor}" />
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding Detail}" Style="{StaticResource Muted}" Margin="0,6,0,0" />
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Discos -->
            <TextBlock Text="Almacenamiento" Style="{StaticResource H2}" Margin="0,0,0,12" />
            <ItemsControl ItemsSource="{Binding Disks}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><UniformGrid Columns="3" /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Margin="0,0,12,12" Padding="16,14">
                            <StackPanel>
                                <DockPanel>
                                    <views:Pill DockPanel.Dock="Right" Text="{Binding Health}" Color="{Binding HealthColor}" />
                                    <TextBlock Text="{Binding Model}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                </DockPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <views:Pill Text="{Binding Kind}" Color="#60A5FA" />
                                    <views:Pill Text="{Binding Size}" Color="#94A3B8" />
                                    <views:Pill Text="Windows" Color="#A78BFA" Visibility="{Binding IsSystem, Converter={StaticResource BoolToVis}}" />
                                </StackPanel>
                                <TextBlock Style="{StaticResource Caption}" Margin="0,8,0,0">
                                    <Run Text="Unidades: " /><Run Text="{Binding Letters, Mode=OneWay}" />
                                    <Run Text=" · Temp: " /><Run Text="{Binding Temp, Mode=OneWay}" />
                                    <Run Text=" " /><Run Text="{Binding Wear, Mode=OneWay}" />
                                </TextBlock>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
