<UserControl x:Class="KizaTweaks.App.Views.AboutView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,28,32,40" MaxWidth="960" HorizontalAlignment="Left">

            <!-- Quién la hizo -->
            <Border Style="{StaticResource Card}" Padding="28" Margin="0,0,0,18">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="104" Height="104" CornerRadius="26" Background="{StaticResource BrandGradient}" VerticalAlignment="Top">
                        <TextBlock Text="Q" FontFamily="{StaticResource DisplayFont}" FontSize="60" FontWeight="SemiBold" Foreground="White"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,4" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="26,0,0,0">
                        <TextBlock Text="{Binding Author}" Style="{StaticResource H1}" FontSize="40" />
                        <TextBlock Text="{Binding Tagline}" Foreground="{StaticResource MutedBrush}" FontSize="15" Margin="0,0,0,14" />
                        <ItemsControl ItemsSource="{Binding Bio}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" TextWrapping="Wrap" FontSize="15" LineHeight="24" MaxWidth="700"
                                               HorizontalAlignment="Left" Margin="0,0,0,10" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="— Qkiub" Foreground="{StaticResource MutedBrush}" FontStyle="Italic" Margin="0,2,0,0" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Compromisos -->
            <ItemsControl ItemsSource="{Binding Promises}" Margin="0,0,-14,18">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><UniformGrid Columns="3" /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Margin="0,0,14,0">
                            <StackPanel>
                                <TextBlock Text="{Binding Glyph}" Style="{StaticResource Icon}" FontSize="22" Foreground="{StaticResource AccentBrush}"
                                           HorizontalAlignment="Left" />
                                <TextBlock Text="{Binding Title}" Style="{StaticResource H2}" Margin="0,12,0,4" />
                                <TextBlock Text="{Binding Text}" Style="{StaticResource Muted}" FontSize="13" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Lo que no hago -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,18">
                <StackPanel>
                    <TextBlock Text="Lo que KizaTweaks nunca va a hacer" Style="{StaticResource H2}" />
                    <TextBlock Text="Son trucos populares que dañan Windows o no dan FPS de verdad." Style="{StaticResource Caption}" Margin="0,2,0,12" />
                    <ItemsControl ItemsSource="{Binding WhatWeDontDo}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="0,5">
                                    <TextBlock DockPanel.Dock="Left" Text="&#xE711;" Style="{StaticResource Icon}" FontSize="11"
                                               Foreground="{StaticResource DangerBrush}" VerticalAlignment="Top" Margin="0,5,12,0" />
                                    <TextBlock Text="{Binding}" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" />
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Versión y enlaces -->
            <DockPanel Margin="4,0,0,0">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Command="{Binding OpenIssuesCommand}" Style="{StaticResource GhostButton}" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xEBE8;" Style="{StaticResource Icon}" FontSize="14" />
                            <TextBlock Text="Reportar un problema" Margin="8,0,0,0" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding OpenRepoCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE943;" Style="{StaticResource Icon}" FontSize="14" />
                            <TextBlock Text="Ver el código" Margin="8,0,0,0" />
                        </StackPanel>
                    </Button>
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="/Assets/logo.png" Width="28" Height="28" RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock VerticalAlignment="Center" Margin="10,0,0,0" Foreground="{StaticResource MutedBrush}">
                        <Run Text="KizaTweaks" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                        <Run Text="{Binding Version, Mode=OneWay}" />
                    </TextBlock>
                </StackPanel>
            </DockPanel>
            <TextBlock Style="{StaticResource Caption}" Margin="4,14,0,0" MaxWidth="820" HorizontalAlignment="Left"
                       Text="KizaTweaks cambia la configuración de Windows. Crea un punto de restauración antes de cambios grandes y mide los resultados en Benchmark. Tus respaldos y registros quedan en C:\ProgramData\KizaTweaks." />
        </StackPanel>
    </ScrollViewer>
</UserControl>
