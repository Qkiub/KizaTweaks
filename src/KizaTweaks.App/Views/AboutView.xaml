<UserControl x:Class="KizaTweaks.App.Views.AboutView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:KizaTweaks.App.Views">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,28,32,40" MaxWidth="820" HorizontalAlignment="Left">

            <Border Style="{StaticResource Card}" Padding="26,24" Margin="0,0,0,16">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Image Source="/Assets/logo.png" Width="64" Height="64" RenderOptions.BitmapScalingMode="HighQuality" />
                        <StackPanel Margin="18,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="KizaTweaks" Style="{StaticResource H1}" />
                            <TextBlock Text="Optimizador de Windows para juegos" Foreground="{StaticResource MutedBrush}" />
                            <TextBlock Style="{StaticResource Caption}" Margin="0,2,0,0">
                                <Run Text="Qkiub," /> <Run Text="{Binding Version, Mode=OneWay}" />
                            </TextBlock>
                        </StackPanel>
                    </StackPanel>

                    <TextBlock Style="{StaticResource Muted}" Margin="0,18,0,0" MaxWidth="680" HorizontalAlignment="Left"
                               Text="Cada ajuste muestra qué cambia y se puede deshacer desde Respaldos. La app no envía datos ni muestra anuncios." />

                    <WrapPanel Margin="0,18,0,0">
                        <Button Command="{Binding OpenRepoCommand}" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE943;" Style="{StaticResource Icon}" FontSize="14" />
                                <TextBlock Text="Código fuente" Margin="8,0,0,0" />
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding OpenIssuesCommand}" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xEBE8;" Style="{StaticResource Icon}" FontSize="14" />
                                <TextBlock Text="Reportar un problema" Margin="8,0,0,0" />
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding OpenDataCommand}" Style="{StaticResource GhostButton}" Padding="12,8">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE838;" Style="{StaticResource Icon}" FontSize="14" />
                                <TextBlock Text="Carpeta de datos" Margin="8,0,0,0" />
                            </StackPanel>
                        </Button>
                    </WrapPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Padding="26,22" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="No incluido" Style="{StaticResource H2}" />
                    <TextBlock Style="{StaticResource Caption}" Margin="0,2,0,12"
                               Text="Trucos comunes que quedaron fuera porque dañan Windows o no mejoran el rendimiento." />
                    <ItemsControl ItemsSource="{Binding NotIncluded}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><views:RowGrid Columns="2" Gap="10" /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="0,0,16,0">
                                    <Border DockPanel.Dock="Left" Width="5" Height="5" CornerRadius="3" Background="{StaticResource SubtleBrush}"
                                            VerticalAlignment="Top" Margin="0,8,10,0" />
                                    <TextBlock Text="{Binding}" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" />
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <TextBlock Style="{StaticResource Caption}" Margin="4,0,0,0"
                       Text="KizaTweaks cambia la configuración de Windows. Crea un punto de restauración antes de cambios grandes." />
        </StackPanel>
    </ScrollViewer>
</UserControl>
