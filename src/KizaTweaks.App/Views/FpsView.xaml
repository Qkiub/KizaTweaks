<UserControl x:Class="KizaTweaks.App.Views.FpsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:KizaTweaks.App.Views">
    <UserControl.Resources>
        <!-- Interruptor que refleja el estado real del ajuste (IsApplied) y ejecuta el comando al hacer clic -->
        <Style x:Key="TweakSwitch" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Track" Width="46" Height="26" CornerRadius="13" Background="{StaticResource BgBrush}"
                                BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
                            <Ellipse x:Name="Thumb" Width="16" Height="16" Fill="{StaticResource SubtleBrush}"
                                     HorizontalAlignment="Left" Margin="4,0" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsApplied}" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{StaticResource BrandGradient}" />
                                <Setter TargetName="Track" Property="BorderBrush" Value="Transparent" />
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right" />
                                <Setter TargetName="Thumb" Property="Fill" Value="White" />
                            </DataTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Track" Property="Opacity" Value="0.88" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Track" Property="BorderBrush" Value="{StaticResource Accent2Brush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,28,32,40">

            <!-- ============ Encabezado con medidor ============ -->
            <Border Style="{StaticResource Card}" Padding="28,24" Margin="0,0,0,18">
                <Border.Background>
                    <!-- Calor tenue detrás del medidor -->
                    <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                        <GradientStop Color="#E0301626" Offset="0" />
                        <GradientStop Color="#D9150F15" Offset="0.45" />
                    </LinearGradientBrush>
                </Border.Background>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <views:Gauge Value="{Binding Percent}" Caption="{Binding ScoreLabel}" VerticalAlignment="Center" />

                    <StackPanel Grid.Column="1" Margin="32,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Modo FPS" Style="{StaticResource H1}" FontSize="40" />
                        <TextBlock Style="{StaticResource Muted}" FontSize="15" Margin="0,4,0,0" MaxWidth="620" HorizontalAlignment="Left"
                                   Text="Solo ajustes que dan rendimiento sin cambiar cómo funcionan tus apps y juegos. Cada uno se prende y se apaga con un clic." />
                        <TextBlock Text="{Binding ScoreText}" Margin="0,14,0,0" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding HardwareText}" Style="{StaticResource Caption}" Margin="0,2,0,0" />

                        <WrapPanel Margin="0,18,0,0">
                            <Button Command="{Binding GameSessionCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,10,8"
                                    ToolTip="Cierra navegadores, launchers y apps pesadas que estén abiertas de fondo">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE7FC;" Style="{StaticResource Icon}" FontSize="15" />
                                    <TextBlock Text="Sesión de juego" Margin="8,0,0,0" />
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding AddGameCommand}" Margin="0,0,10,8"
                                    ToolTip="El juego siempre usa la GPU de alto rendimiento">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE710;" Style="{StaticResource Icon}" FontSize="14" />
                                    <TextBlock Text="Configurar mi juego" Margin="8,0,0,0" />
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding CrashReportCommand}" Style="{StaticResource GhostButton}" Margin="0,0,10,8" Padding="14,8"
                                    ToolTip="Muestra qué programas se cerraron solos y por qué">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE7BA;" Style="{StaticResource Icon}" FontSize="14" />
                                    <TextBlock Text="Ver cierres recientes" Margin="8,0,0,0" />
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding BenchmarkCommand}" Style="{StaticResource GhostButton}" Margin="0,0,10,8" Padding="14,8">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE9D9;" Style="{StaticResource Icon}" FontSize="14" />
                                    <TextBlock Text="Medir FPS antes y después" Margin="8,0,0,0" />
                                </StackPanel>
                            </Button>
                        </WrapPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <StackPanel Orientation="Horizontal" Margin="4,0,0,16" Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}">
                <views:Spinner>
                    <views:Spinner.LayoutTransform>
                        <ScaleTransform ScaleX="0.5" ScaleY="0.5" />
                    </views:Spinner.LayoutTransform>
                </views:Spinner>
                <TextBlock Text="Revisando tu equipo…" Style="{StaticResource Muted}" Margin="10,0,0,0" VerticalAlignment="Center" />
            </StackPanel>

            <!-- ============ Niveles ============ -->
            <ItemsControl ItemsSource="{Binding Levels}" Margin="0,0,-14,18">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><UniformGrid Columns="1" /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Margin="0,0,14,0">
                            <DockPanel>
                                <DockPanel DockPanel.Dock="Bottom" Margin="0,16,0,0" LastChildFill="False">
                                    <Button DockPanel.Dock="Right" Command="{Binding ActivateCommand}" Padding="22,9">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsComplete}" Value="True">
                                                        <Setter Property="Background" Value="{StaticResource Surface2Brush}" />
                                                        <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
                                                        <Setter Property="Foreground" Value="{StaticResource OkBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                        <TextBlock Text="{Binding ButtonText}" />
                                    </Button>
                                    <TextBlock Text="{Binding ProgressText}" Style="{StaticResource Caption}" FontSize="13" VerticalAlignment="Center" />
                                </DockPanel>
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="36" Height="36" CornerRadius="9" Background="#26F06292">
                                            <TextBlock Text="{Binding Glyph}" Style="{StaticResource Icon}" FontSize="17"
                                                       Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" />
                                        </Border>
                                        <TextBlock Text="{Binding Name}" Style="{StaticResource H2}" FontSize="22" Margin="12,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding Description}" Style="{StaticResource Muted}" Margin="0,12,0,0" />
                                    <TextBlock Text="{Binding Adjusted}" Foreground="#F3CD8F" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0"
                                               Visibility="{Binding HasAdjusted, Converter={StaticResource BoolToVis}}" />
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- ============ Tu PC + juegos ============ -->
            <Grid Margin="0,0,0,26">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource Card}" Margin="0,0,14,0">
                    <StackPanel>
                        <TextBlock Text="Tu PC para jugar" Style="{StaticResource H2}" />
                        <TextBlock Text="Lo que ningún ajuste de Windows arregla, pero que da más FPS que cualquiera." Style="{StaticResource Caption}" Margin="0,2,0,12" />
                        <ItemsControl ItemsSource="{Binding Checks}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="0,11">
                                        <DockPanel>
                                            <Button DockPanel.Dock="Right" Content="{Binding ActionText}" Command="{Binding ActionCommand}"
                                                    Style="{StaticResource GhostButton}" Foreground="{StaticResource Accent2Brush}" VerticalAlignment="Center"
                                                    Visibility="{Binding HasAction, Converter={StaticResource BoolToVis}}" />
                                            <TextBlock DockPanel.Dock="Left" Text="{Binding Glyph}" Style="{StaticResource Icon}" FontSize="15" VerticalAlignment="Top"
                                                       Margin="0,2,14,0" Foreground="{Binding Color, Converter={StaticResource HexBrush}}" />
                                            <StackPanel>
                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding Detail}" Style="{StaticResource Muted}" FontSize="13" Margin="0,2,0,0" />
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource Card}" Width="330" VerticalAlignment="Top">
                    <StackPanel>
                        <TextBlock Text="Tus juegos" Style="{StaticResource H2}" />
                        <TextBlock Style="{StaticResource Caption}" Margin="0,2,0,12"
                                   Text="Siempre usan la GPU de alto rendimiento (útil en portátiles con dos GPU)." />
                        <TextBlock Style="{StaticResource Muted}" FontSize="13" Margin="0,0,0,12"
                                   Visibility="{Binding HasGames, Converter={StaticResource InverseBoolToVis}}"
                                   Text="Todavía no hay ninguno. Agrega el .exe del juego, no el del launcher." />
                        <ItemsControl ItemsSource="{Binding Games}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource Tile}" Padding="12,10" Margin="0,0,0,8">
                                        <DockPanel>
                                            <Button DockPanel.Dock="Right" Content="&#xE711;" FontFamily="{StaticResource IconFont}" FontSize="11"
                                                    Style="{StaticResource GhostButton}" Command="{Binding RemoveCommand}" ToolTip="Quitar" />
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding ExeName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding Detail}" Style="{StaticResource Caption}" />
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button Command="{Binding AddGameCommand}" HorizontalAlignment="Left" Margin="0,4,0,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE710;" Style="{StaticResource Icon}" FontSize="13" />
                                <TextBlock Text="Agregar juego" Margin="8,0,0,0" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ============ Ajustes por grupo ============ -->
            <ItemsControl ItemsSource="{Binding Groups}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="0,0,0,28">
                            <DockPanel Margin="0,0,0,4">
                                <TextBlock DockPanel.Dock="Right" Text="{Binding ActiveText}" Style="{StaticResource Caption}" FontSize="13" VerticalAlignment="Bottom" />
                                <TextBlock Text="{Binding Glyph}" Style="{StaticResource Icon}" FontSize="18"
                                           Foreground="{Binding Color, Converter={StaticResource HexBrush}}" />
                                <TextBlock Text="{Binding Title}" Style="{StaticResource H2}" FontSize="22" Margin="10,0,0,0" />
                            </DockPanel>
                            <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Muted}" Margin="0,0,0,12" />
                            <ItemsControl ItemsSource="{Binding Items}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><views:RowGrid Columns="2" Gap="12" /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource Tile}">
                                            <DockPanel>
                                                <StackPanel DockPanel.Dock="Right" Margin="16,0,0,0">
                                                    <Button Style="{StaticResource TweakSwitch}" Command="{Binding ToggleCommand}"
                                                            ToolTip="Activar o desactivar" />
                                                    <TextBlock Text="{Binding StatusText}" Style="{StaticResource Caption}" HorizontalAlignment="Center" Margin="0,4,0,0" />
                                                </StackPanel>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="15" TextWrapping="Wrap" />
                                                    <TextBlock Text="{Binding Description}" Style="{StaticResource Muted}" FontSize="13" Margin="0,4,0,0" />
                                                    <WrapPanel Margin="0,10,0,0">
                                                        <views:Pill Text="{Binding ImpactLabel}" Color="{Binding ImpactColor}" />
                                                        <views:Pill Text="{Binding RiskLabel}" Color="{Binding RiskColor}" />
                                                        <views:Pill Text="Reinicio" Color="#FFB86B" Visibility="{Binding RequiresReboot, Converter={StaticResource BoolToVis}}" />
                                                    </WrapPanel>
                                                    <TextBlock Text="{Binding Warning}" Foreground="#F3CD8F" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0"
                                                               Visibility="{Binding HasWarning, Converter={StaticResource BoolToVis}}" />
                                                    <TextBlock Text="{Binding Note}" Style="{StaticResource Caption}" Margin="0,6,0,0"
                                                               Visibility="{Binding HasNote, Converter={StaticResource BoolToVis}}" />
                                                </StackPanel>
                                            </DockPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
