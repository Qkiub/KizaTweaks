<UserControl x:Class="KizaTweaks.App.Views.AdvancedView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:KizaTweaks.App.Views">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,28,32,40">

            <!-- Encabezado -->
            <Border Style="{StaticResource Card}" Padding="28,24" Margin="0,0,0,22" BorderBrush="#66FFB86B">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                        <GradientStop Color="#E02A1C10" Offset="0" />
                        <GradientStop Color="#D9150F15" Offset="0.55" />
                    </LinearGradientBrush>
                </Border.Background>
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" VerticalAlignment="Center" Margin="24,0,0,0"
                                Visibility="{Binding HasActive, Converter={StaticResource BoolToVis}}">
                        <Button Command="{Binding RevertAllCommand}" Style="{StaticResource GhostButton}" Padding="18,10">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE7A7;" Style="{StaticResource Icon}" FontSize="14" />
                                <TextBlock Text="Apagar todos los avanzados" Margin="8,0,0,0" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    <TextBlock DockPanel.Dock="Left" Text="&#xE7BA;" Style="{StaticResource Icon}" FontSize="34"
                               Foreground="{StaticResource WarnBrush}" VerticalAlignment="Top" Margin="0,4,22,0" />
                    <StackPanel>
                        <TextBlock Text="Avanzado" Style="{StaticResource H1}" FontSize="38" />
                        <TextBlock Style="{StaticResource Muted}" FontSize="15" Margin="0,6,0,0" MaxWidth="700" HorizontalAlignment="Left" TextWrapping="Wrap"
                                   Text="Ajustes con más efecto en FPS y delay, pero que en algunos PCs hacen fallar apps como Photoshop o Illustrator, o algunos juegos. Nunca se activan solos: cada uno te dice qué puede causar antes de activarlo." />
                        <TextBlock Margin="0,12,0,0" FontWeight="SemiBold" Foreground="#F3CD8F" TextWrapping="Wrap"
                                   Text="Activa uno a la vez y prueba tus programas. Si algo empieza a fallar, apágalo aquí." />
                    </StackPanel>
                </DockPanel>
            </Border>

            <ItemsControl ItemsSource="{Binding Groups}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="0,0,0,28">
                            <DockPanel Margin="0,0,0,4">
                                <TextBlock DockPanel.Dock="Right" Text="{Binding ActiveText}" Style="{StaticResource Caption}" FontSize="13" VerticalAlignment="Bottom" />
                                <TextBlock Text="{Binding Glyph}" Style="{StaticResource Icon}" FontSize="18" Foreground="{StaticResource WarnBrush}" />
                                <TextBlock Text="{Binding Title}" Style="{StaticResource H2}" FontSize="22" Margin="10,0,0,0" />
                            </DockPanel>
                            <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Muted}" Margin="0,0,0,12" />
                            <ItemsControl ItemsSource="{Binding Items}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><views:RowGrid Columns="2" Gap="12" /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource Tile}">
                                            <DockPanel>
                                                <StackPanel DockPanel.Dock="Right" Margin="16,0,0,0">
                                                    <Button Style="{StaticResource TweakSwitch}" Command="{Binding ToggleCommand}" ToolTip="Activar o desactivar" />
                                                    <TextBlock Text="{Binding StatusText}" Style="{StaticResource Caption}" HorizontalAlignment="Center" Margin="0,4,0,0" />
                                                </StackPanel>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="15" TextWrapping="Wrap" />
                                                    <TextBlock Text="{Binding Description}" Style="{StaticResource Muted}" FontSize="13" Margin="0,4,0,0" />
                                                    <WrapPanel Margin="0,10,0,0">
                                                        <views:Pill Text="{Binding ImpactLabel}" Color="{Binding ImpactColor}" />
                                                        <views:Pill Text="{Binding RiskLabel}" Color="{Binding RiskColor}" />
                                                        <views:Pill Text="Reinicio" Color="#FFB86B" Visibility="{Binding RequiresReboot, Converter={StaticResource BoolToVis}}" />
                                                    </WrapPanel>
                                                    <Border Background="#1FFFB86B" CornerRadius="6" Padding="10,7" Margin="0,10,0,0"
                                                            Visibility="{Binding HasWarning, Converter={StaticResource BoolToVis}}">
                                                        <TextBlock Text="{Binding Warning}" Foreground="#F3CD8F" FontSize="12.5" TextWrapping="Wrap" />
                                                    </Border>
                                                </StackPanel>
                                            </DockPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
