<UserControl x:Class="KizaTweaks.App.Views.OptimizeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:KizaTweaks.App.Views">
    <UserControl.Resources>
        <Style x:Key="SectionButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Padding" Value="18,8" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsComplete}" Value="True">
                    <Setter Property="Background" Value="{StaticResource Surface2Brush}" />
                    <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
                    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="CardButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Padding" Value="18,8" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsDone}" Value="True">
                    <Setter Property="Background" Value="{StaticResource Surface2Brush}" />
                    <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
                    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <DataTemplate x:Key="CardHeader">
            <StackPanel Orientation="Horizontal">
                <Border Width="38" Height="38" CornerRadius="10" Background="#26F06292">
                    <TextBlock Text="{Binding Glyph}" Style="{StaticResource Icon}" FontSize="17"
                               Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" />
                </Border>
                <TextBlock Text="{Binding Title}" Style="{StaticResource H2}" FontSize="21" Margin="12,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
        </DataTemplate>
        <DataTemplate x:Key="AppCheck">
            <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}" Margin="0,3,12,3" ToolTip="{Binding Detail}">
                <TextBlock Text="{Binding Text}" TextTrimming="CharacterEllipsis" />
            </CheckBox>
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,28,32,40">

            <!-- ============ Encabezado ============ -->
            <Border Style="{StaticResource Card}" Padding="28,24" Margin="0,0,0,18">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                        <GradientStop Color="#E0301626" Offset="0" />
                        <GradientStop Color="#D9150F15" Offset="0.5" />
                    </LinearGradientBrush>
                </Border.Background>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <views:Gauge Value="{Binding Percent}" Caption="seguro" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" Margin="30,0,24,0" VerticalAlignment="Center">
                        <TextBlock Text="Optimización segura" Style="{StaticResource H1}" FontSize="34" TextWrapping="Wrap" />
                        <TextBlock Style="{StaticResource Muted}" FontSize="15" Margin="0,6,0,0" MaxWidth="640" HorizontalAlignment="Left"
                                   Text="Quita lo inservible, baja el input lag y deja Windows rápido. Nada de esto cambia cómo funcionan Photoshop, tus apps o tus juegos." />
                        <TextBlock Text="{Binding ScoreText}" Margin="0,14,0,0" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding HardwareText}" Style="{StaticResource Caption}" Margin="0,4,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                        <Button Command="{Binding DoAllCommand}" Style="{StaticResource PrimaryButton}" Padding="28,14">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE945;" Style="{StaticResource Icon}" FontSize="16" />
                                <TextBlock Text="Optimizar todo" FontSize="16" Margin="10,0,0,0" />
                            </StackPanel>
                        </Button>
                        <TextBlock Text="Crea un punto de restauración antes" Style="{StaticResource Caption}" HorizontalAlignment="Center" Margin="0,8,0,0" />
                    </StackPanel>
                </Grid>
            </Border>

            <StackPanel Orientation="Horizontal" Margin="4,0,0,16" Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}">
                <views:Spinner>
                    <views:Spinner.LayoutTransform>
                        <ScaleTransform ScaleX="0.5" ScaleY="0.5" />
                    </views:Spinner.LayoutTransform>
                </views:Spinner>
                <TextBlock Text="Revisando tu equipo…" Style="{StaticResource Muted}" Margin="10,0,0,0" VerticalAlignment="Center" />
            </StackPanel>

            <!-- ============ Secciones con interruptores ============ -->
            <ItemsControl ItemsSource="{Binding Sections}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><views:RowGrid Columns="2" Gap="14" /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource CardHeader}" />
                                <TextBlock Text="{Binding Description}" Style="{StaticResource Muted}" Margin="0,12,0,10" />
                                <DockPanel Margin="0,0,0,10">
                                    <Button DockPanel.Dock="Right" Command="{Binding ActivateCommand}"
                                            Style="{StaticResource SectionButton}" Content="Activar todo" />
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="&#xE73E;" Style="{StaticResource Icon}" FontSize="12" Foreground="{StaticResource OkBrush}" Margin="0,0,6,0"
                                                   Visibility="{Binding IsComplete, Converter={StaticResource BoolToVis}}" />
                                        <TextBlock Text="{Binding ActiveText}" Style="{StaticResource Caption}" FontSize="13" />
                                    </StackPanel>
                                </DockPanel>
                                <ItemsControl ItemsSource="{Binding Items}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="0,10,0,10">
                                                <DockPanel>
                                                    <Button DockPanel.Dock="Right" Style="{StaticResource TweakSwitch}" Command="{Binding ToggleCommand}"
                                                            VerticalAlignment="Center" Margin="14,0,0,0" ToolTip="Activar o desactivar" />
                                                    <StackPanel>
                                                        <DockPanel>
                                                            <views:Pill DockPanel.Dock="Right" Text="Reinicio" Color="#FFB86B" Margin="8,0,0,0" VerticalAlignment="Top"
                                                                        Visibility="{Binding RequiresReboot, Converter={StaticResource BoolToVis}}" />
                                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                        </DockPanel>
                                                        <TextBlock Text="{Binding Description}" Style="{StaticResource Caption}" FontSize="12.5" Margin="0,3,0,0" TextWrapping="Wrap" />
                                                    </StackPanel>
                                                </DockPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- ============ Apps ============ -->
            <Border Style="{StaticResource Card}" Margin="0,14,0,14" DataContext="{Binding Apps}">
                <StackPanel>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="{Binding ButtonText}" Command="{Binding Command}"
                                Style="{StaticResource CardButton}" VerticalAlignment="Top" />
                        <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource CardHeader}" />
                    </DockPanel>
                    <TextBlock Text="{Binding Description}" Style="{StaticResource Muted}" Margin="0,12,0,12" />
                    <DockPanel Margin="0,0,0,10" LastChildFill="False">
                        <TextBlock Text="&#xE73E;" Style="{StaticResource Icon}" FontSize="13" Foreground="{StaticResource OkBrush}" Margin="0,0,6,0"
                                   VerticalAlignment="Center" Visibility="{Binding IsDone, Converter={StaticResource BoolToVis}}" />
                        <TextBlock Text="{Binding Status}" Style="{StaticResource Caption}" FontSize="13" VerticalAlignment="Center" />
                        <Button DockPanel.Dock="Right" Content="Desmarcar todo" Style="{StaticResource GhostButton}"
                                Command="{Binding DataContext.UncheckAllAppsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                        <Button DockPanel.Dock="Right" Content="Marcar todo" Style="{StaticResource GhostButton}" Margin="0,0,6,0"
                                Command="{Binding DataContext.CheckAllAppsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                    </DockPanel>
                    <ItemsControl ItemsSource="{Binding Items}" ItemTemplate="{StaticResource AppCheck}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><UniformGrid Columns="4" /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                    <StackPanel Visibility="{Binding DataContext.HasExtraApps, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVis}}">
                        <Border Height="1" Background="{StaticResource LineBrush}" Margin="0,14,0,12" />
                        <TextBlock Text="Otras apps de la Store en tu PC" Style="{StaticResource H2}" FontSize="16" />
                        <TextBlock Text="No están en la lista de basura. Marca solo las que no instalaste tú." Style="{StaticResource Caption}" Margin="0,2,0,8" />
                        <ItemsControl ItemsSource="{Binding Extra}" ItemTemplate="{StaticResource AppCheck}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><UniformGrid Columns="4" /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ============ Limpieza ============ -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,14" DataContext="{Binding Clean}">
                <StackPanel>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="{Binding ButtonText}" Command="{Binding Command}"
                                Style="{StaticResource CardButton}" VerticalAlignment="Top" />
                        <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource CardHeader}" />
                    </DockPanel>
                    <TextBlock Text="{Binding Description}" Style="{StaticResource Muted}" Margin="0,12,0,12" />
                    <DockPanel Margin="0,0,0,10" LastChildFill="False">
                        <TextBlock Text="&#xE73E;" Style="{StaticResource Icon}" FontSize="13" Foreground="{StaticResource OkBrush}" Margin="0,0,6,0"
                                   VerticalAlignment="Center" Visibility="{Binding IsDone, Converter={StaticResource BoolToVis}}" />
                        <TextBlock Text="{Binding Status}" Style="{StaticResource Caption}" FontSize="13" VerticalAlignment="Center" />
                        <Button DockPanel.Dock="Right" Content="Revisar de nuevo" Style="{StaticResource GhostButton}"
                                Command="{Binding DataContext.RescanJunkCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                    </DockPanel>
                    <ItemsControl ItemsSource="{Binding Items}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><views:RowGrid Columns="2" Gap="8" /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource Surface2Brush}" CornerRadius="8" Padding="12,9">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding Size}" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}"
                                                   VerticalAlignment="Top" Margin="12,1,0,0" />
                                        <CheckBox DockPanel.Dock="Left" IsChecked="{Binding IsChecked, Mode=TwoWay}" VerticalAlignment="Top" Margin="0,1,8,0" />
                                        <StackPanel Background="Transparent" Cursor="Hand">
                                            <StackPanel.InputBindings>
                                                <MouseBinding MouseAction="LeftClick" Command="{Binding ToggleCommand}" />
                                            </StackPanel.InputBindings>
                                            <TextBlock Text="{Binding Text}" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding Detail}" Style="{StaticResource Caption}" FontSize="12" Margin="0,2,0,0" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- ============ Avanzado ============ -->
            <Border Style="{StaticResource Card}" BorderBrush="#4DFFB86B">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Command="{Binding GoAdvancedCommand}" Style="{StaticResource GhostButton}" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Ver avanzado" />
                            <TextBlock Text="&#xE72A;" Style="{StaticResource Icon}" FontSize="12" Margin="8,0,0,0" />
                        </StackPanel>
                    </Button>
                    <TextBlock Text="&#xE7BA;" Style="{StaticResource Icon}" FontSize="22" Foreground="{StaticResource WarnBrush}" VerticalAlignment="Center" />
                    <StackPanel Margin="16,0,16,0">
                        <TextBlock Text="¿Quieres exprimir más?" Style="{StaticResource H2}" FontSize="18" />
                        <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,0" TextWrapping="Wrap"
                                   Text="En «Avanzado» están los ajustes con más efecto en FPS y delay. Pueden hacer fallar apps como Photoshop o algunos juegos, así que nunca se activan solos y cada uno dice qué puede causar." />
                    </StackPanel>
                </DockPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
