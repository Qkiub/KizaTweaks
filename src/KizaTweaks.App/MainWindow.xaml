<Window x:Class="KizaTweaks.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:KizaTweaks.Presentation.ViewModels;assembly=KizaTweaks.Presentation"
        xmlns:views="clr-namespace:KizaTweaks.App.Views"
        Title="KizaTweaks by Qkiub" Icon="Assets/kizatweaks.ico"
        Width="1320" Height="860" MinWidth="1080" MinHeight="680"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="{StaticResource UiFont}" FontSize="14"
        TextOptions.TextFormattingMode="Display" UseLayoutRounding="True">

    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:OptimizeViewModel}"><views:OptimizeView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:AdvancedViewModel}"><views:AdvancedView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:FpsViewModel}"><views:FpsView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:TweaksViewModel}"><views:TweaksView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:AppsViewModel}"><views:AppsView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:ProcessesViewModel}"><views:ProcessesView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:StartupViewModel}"><views:StartupView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:MaintenanceViewModel}"><views:MaintenanceView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:BenchmarkViewModel}"><views:BenchmarkView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:BackupsViewModel}"><views:BackupsView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:AboutViewModel}"><views:AboutView /></DataTemplate>
    </Window.Resources>

    <Grid x:Name="RootGrid" Background="{StaticResource BgBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Fondo: noche de sakura con siluetas muy difuminadas -->
        <Image Grid.ColumnSpan="2" Source="Assets/background.jpg" Stretch="UniformToFill"
               HorizontalAlignment="Right" VerticalAlignment="Top" IsHitTestVisible="False"
               RenderOptions.BitmapScalingMode="HighQuality" />

        <!-- ================= Barra lateral ================= -->
        <Border Background="{StaticResource SidebarBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,1,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="22,22,16,28">
                    <Image Source="Assets/logo-mark.png" Width="44" Height="44" RenderOptions.BitmapScalingMode="HighQuality" />
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="KizaTweaks" FontFamily="{StaticResource DisplayFont}" FontSize="21" FontWeight="SemiBold" />
                        <!-- El "KT" en japonés del logo, como texto real para que se lea en tamaño pequeño -->
                        <TextBlock Text="ケーティー" FontFamily="Yu Gothic UI, Meiryo UI, Segoe UI" FontSize="12"
                                   Foreground="{StaticResource MutedBrush}" Margin="1,0,0,0" />
                    </StackPanel>
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom" Margin="24,12,16,20">
                    <Border Background="#26FF5C7A" CornerRadius="8" Padding="10,8" Margin="0,0,0,12"
                            Visibility="{Binding IsAdmin, Converter={StaticResource InverseBoolToVis}}">
                        <TextBlock Text="Sin permisos de administrador: ábrelo como administrador." TextWrapping="Wrap"
                                   FontSize="12" Foreground="#FFAFC0" />
                    </Border>
                    <TextBlock Text="{Binding OsInfo}" Style="{StaticResource Caption}" />
                    <TextBlock Style="{StaticResource Caption}" Margin="0,2,0,0">
                        <Run Text="Qkiub," /> <Run Text="{Binding About.Version, Mode=OneWay}" />
                    </TextBlock>
                </StackPanel>

                <ListBox ItemsSource="{Binding Nav}" SelectedItem="{Binding SelectedNav, Mode=TwoWay}"
                         Style="{StaticResource PlainListBox}" ItemContainerStyle="{StaticResource NavItem}">
                    <ListBox.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.HeaderTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource SubtleBrush}"
                                               Margin="14,10,0,4" />
                                </DataTemplate>
                            </GroupStyle.HeaderTemplate>
                        </GroupStyle>
                    </ListBox.GroupStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="Glyph" Text="{Binding Glyph}" Style="{StaticResource Icon}" Width="22" />
                                <TextBlock Text="{Binding Title}" Margin="10,0,0,0" VerticalAlignment="Center" FontWeight="SemiBold" />
                            </StackPanel>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                    <Setter TargetName="Glyph" Property="Foreground" Value="{StaticResource AccentBrush}" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- ================= Contenido ================= -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Background="#1FFFB547" BorderBrush="#4DFFB547" BorderThickness="0,0,0,1" Padding="28,10"
                    Visibility="{Binding RebootRequired, Converter={StaticResource BoolToVis}}">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Reiniciar ahora" Command="{Binding RebootCommand}"
                            Style="{StaticResource PrimaryButton}" Padding="14,6" />
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="&#xE7BA;" Style="{StaticResource Icon}" Foreground="{StaticResource WarnBrush}" />
                        <TextBlock Margin="10,0,0,0" VerticalAlignment="Center" Foreground="#F3CD8F"
                                   Text="Algunos cambios necesitan reiniciar Windows para tener efecto." />
                    </StackPanel>
                </DockPanel>
            </Border>

            <ContentControl Grid.Row="1" Content="{Binding CurrentPage}" Focusable="False" />
        </Grid>

        <!-- ================= Aviso flotante ================= -->
        <Border Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="28" MaxWidth="540"
                CornerRadius="12" Padding="16,12" BorderThickness="1"
                Visibility="{Binding HasToast, Converter={StaticResource BoolToVis}}">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="{StaticResource SurfaceSolidBrush}" />
                    <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ToastIsError}" Value="True">
                            <Setter Property="BorderBrush" Value="{StaticResource DangerBrush}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Border.Effect>
                <DropShadowEffect BlurRadius="28" ShadowDepth="6" Opacity="0.55" Color="Black" />
            </Border.Effect>
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="&#xE711;" FontFamily="{StaticResource IconFont}" FontSize="11"
                        Style="{StaticResource GhostButton}" Command="{Binding DismissToastCommand}" Margin="12,0,0,0"
                        ToolTip="Cerrar aviso" />
                <TextBlock DockPanel.Dock="Left" Margin="0,0,12,0" VerticalAlignment="Top">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource Icon}">
                            <Setter Property="Text" Value="&#xE73E;" />
                            <Setter Property="Foreground" Value="{StaticResource OkBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ToastIsError}" Value="True">
                                    <Setter Property="Text" Value="&#xE783;" />
                                    <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBlock Text="{Binding ToastText}" TextWrapping="Wrap" VerticalAlignment="Center" />
            </DockPanel>
        </Border>

        <!-- ================= Ocupado ================= -->
        <Grid Grid.ColumnSpan="2" Background="{StaticResource OverlayBrush}"
              Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
            <Border Style="{StaticResource Card}" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="36,30" MinWidth="400" MaxWidth="580">
                <StackPanel HorizontalAlignment="Center">
                    <views:Spinner HorizontalAlignment="Center" />
                    <TextBlock Text="{Binding BusyText}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,18,0,0" FontSize="15" />
                    <TextBlock Text="No cierres KizaTweaks mientras trabaja." Style="{StaticResource Caption}"
                               HorizontalAlignment="Center" Margin="0,8,0,0" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
